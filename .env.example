# URL base del backend — sin barra final
#
# Desarrollo (Vite proxy en vite.config.ts reenvía /api → localhost:8080):
VITE_API_BASE_URL=/api/v1
#
# Producción (Firebase Hosting → GKE api-gateway):
# Obtener el IP con: kubectl get svc api-gateway -n cv-platform  (columna EXTERNAL-IP)
# En CI/CD se pasa como secret VITE_API_BASE_URL en GitHub Actions.
# Para build local de producción: copiar este archivo a .env.production y completar.
# VITE_API_BASE_URL=http://CHANGE_ME_GKE_LB_IP/api/v1

# API Key: se ingresa en runtime desde la pantalla Config de la app (localStorage).
# No se configura como variable de entorno — no agregar aquí.
